




LOG_LEVEL=INFO

# Direct Groq calls made by extraction, generation and quality evaluation.
# HTTP 429 responses honor Retry-After; otherwise exponential backoff is used.
GROQ_MAX_RETRIES=5
GROQ_RETRY_BASE_SECONDS=2
GROQ_RETRY_MAX_SECONDS=60
GROQ_RETRY_JITTER_SECONDS=1
GROQ_TIMEOUT_SECONDS=120

# Source-grounded quality evaluation.
QUALITY_MIN_GROUNDEDNESS=0.75
QUALITY_MIN_COHERENCE=0.75
QUALITY_EVIDENCE_MAX_CHARS=40000
QUALITY_DRAFT_MAX_CHARS=30000
# Optional provider-specific lower-cost model for the quality judge.
QUALITY_LLM_MODEL=

# A scanner load/runtime failure becomes a blocking finding when true.
LLM_GUARD_FAIL_CLOSED=true


ANYTHINGLLM_BASE_URL=http://localhost:3001/api
ANYTHINGLLM_TIMEOUT_SECONDS=30
ANYTHINGLLM_MAX_RETRIES=5
ANYTHINGLLM_RETRY_BASE_SECONDS=2
ANYTHINGLLM_RETRY_MAX_SECONDS=60
ANYTHINGLLM_RETRY_JITTER_SECONDS=1
# Serialize hosted vector searches and leave this gap between calls.
ANYTHINGLLM_VECTOR_MIN_INTERVAL_SECONDS=1

# The agent backend calls this service for bilingual OCR, table extraction,
# layout metadata and AnythingLLM indexing.
EXTRACTOR_BASE_URL=http://localhost:8007
EXTRACTOR_API_KEY=
EXTRACTOR_TIMEOUT_SECONDS=900
EXTRACTOR_MAX_RETRIES=3
EXTRACTOR_RETRY_BACKOFF_SECONDS=1

# Phase 2 retrieval. AnythingLLM owns parsing, OCR, embeddings and Qdrant;
# this app fetches extra candidates and performs a lightweight second pass.
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATE_MULTIPLIER=2

FAST_LLM=ollama:llama3.1
SMART_LLM=ollama:llama3.1
STRATEGIC_LLM=ollama:llama3.1
EMBEDDING=ollama:nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
RETRIEVER=duckduckgo
