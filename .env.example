# --- AnythingLLM server (the Node.js backend in ../anything-llm-lightweight/server) ---
# Used for document embedding + vector-search (retrieval) ONLY now —
# see providers/ for which model actually generates text.
ANYTHINGLLM_BASE_URL=http://localhost:3001/api

# --- LLM provider for extraction/research/generation (see providers/) ---
# ollama (default, local, no API key) | groq (cloud, fast)
LLM_PROVIDER=ollama
GROQ_API_KEY= ur grock api key
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- GPT Researcher config (its own, separate provider selection) ---
FAST_LLM=groq:llama-3.1-8b-instant
SMART_LLM=groq:llama-3.3-70b-versatile
STRATEGIC_LLM=groq:llama-3.3-70b-versatile
EMBEDDING=ollama:nomic-embed-text
RETRIEVER=duckduckgo