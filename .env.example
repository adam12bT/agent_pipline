
LOG_LEVEL=INFO

# Direct agent LLM: ollama or groq.
LLM_PROVIDER=ollama

# Direct Groq calls made by extraction, generation and quality evaluation.
# HTTP 429 responses honor Retry-After; otherwise exponential backoff is used.
GROQ_MAX_RETRIES=1
GROQ_RETRY_BASE_SECONDS=2
GROQ_RETRY_MAX_SECONDS=60
GROQ_MAX_RETRY_AFTER_SECONDS=60
GROQ_RETRY_JITTER_SECONDS=1
# Built-in default is 30 seconds; keep direct and GPT Researcher calls paced.
GROQ_MIN_INTERVAL_SECONDS=30
GROQ_TIMEOUT_SECONDS=120

# Source-grounded quality evaluation.
QUALITY_MIN_GROUNDEDNESS=0.75
QUALITY_MIN_COHERENCE=0.75
QUALITY_EVIDENCE_MAX_CHARS=6000
QUALITY_DRAFT_MAX_CHARS=6000
QUALITY_EVALUATION_BATCHES=1
QUALITY_MAX_TOKENS=512
MAX_GENERATION_ATTEMPTS=1
# Optional provider-specific lower-cost model for the quality judge.
QUALITY_LLM_MODEL=

# Proposal generation dynamically follows the uploaded template and processes
# this many consecutive sections per sequential LLM request.
GENERATION_BATCH_SIZE=3
GENERATION_BATCH_MAX_TOKENS=1800
GENERATION_CONTEXT_MAX_CHARS=6000
# Total rendered prompt cap. This is built into code and need not be set on HF.
GENERATION_PROMPT_MAX_CHARS=13000

# Disabled by default for lightweight Hugging Face deployments. Local PII,
# groundedness, coherence, template, section, and length checks remain active.
LLM_GUARD_ENABLED=false
# Disable the lightweight email/phone regex scanner too. When both are false,
# the report explicitly states that no automated security scan was performed.
SECURITY_FALLBACK_ENABLED=false
# Used only when LLM Guard is enabled.
LLM_GUARD_FAIL_CLOSED=true


ANYTHINGLLM_BASE_URL=http://localhost:3001/api
ANYTHINGLLM_TIMEOUT_SECONDS=30
ANYTHINGLLM_MAX_RETRIES=3
ANYTHINGLLM_RETRY_BASE_SECONDS=2
ANYTHINGLLM_RETRY_MAX_SECONDS=60
ANYTHINGLLM_RETRY_JITTER_SECONDS=1
# Serialize hosted vector searches and leave this gap between calls.
ANYTHINGLLM_VECTOR_MIN_INTERVAL_SECONDS=1

# The agent backend calls this service for bilingual OCR, table extraction,
# layout metadata and AnythingLLM indexing.
EXTRACTOR_BASE_URL=http://localhost:8007
EXTRACTOR_API_KEY=
EXTRACTOR_TIMEOUT_SECONDS=1800
EXTRACTOR_MAX_RETRIES=6
EXTRACTOR_RETRY_BACKOFF_SECONDS=5
EXTRACTOR_RETRY_MAX_SECONDS=60
EXTRACTOR_RETRY_JITTER_SECONDS=1
PIPELINE_MAX_CONCURRENT_RUNS=1

# Phase 2 retrieval. AnythingLLM owns parsing, OCR, embeddings and Qdrant;
# this app fetches extra candidates and performs a lightweight second pass.
RAG_RERANK_ENABLED=true
RAG_RERANK_CANDIDATE_MULTIPLIER=2

FAST_LLM=ollama:llama3.1
SMART_LLM=ollama:llama3.1
STRATEGIC_LLM=ollama:llama3.1
EMBEDDING=ollama:nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
RETRIEVER=duckduckgo
